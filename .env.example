# Server Environment Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_change_in_production

# Comma-separated list of allowed CORS origins for dev and production.
# IMPORTANT: Every origin served by the frontend (e.g. dev ports & deployed domains) must be listed here
# AND stay in sync with Google Cloud Console "Authorized JavaScript origins" for VITE_GOOGLE_CLIENT_ID.
# Setting '*' allows requests across all links, domains, and preview environments.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000,https://do-this.netlify.app,*

# Database Configuration
DATABASE_URL=server/database.sqlite

# Email Provider Configuration (Resend / SMTP)
RESEND_API_KEY=
EMAIL_FROM=TaskPulse <notifications@taskpulse.app>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Frontend Environment Configuration
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID
# NOTE: Authorized JavaScript origins in Google Cloud Console must include all origins listed in ALLOWED_ORIGINS above.
VITE_GOOGLE_CLIENT_ID=1005301953165-6crod6p1tt7m2h2qck0km5s6ibjj9mmd.apps.googleusercontent.com
